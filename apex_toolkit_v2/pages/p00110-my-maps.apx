page 110 (
    name: My maps
    alias: MY-MAPS
    title: KMLeon · My maps
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region signin (
        name: Sign in
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            htmlCode:
                ```html
                <p>Sign in to see the maps that were created for you.</p>
                ```
        }
        serverSideCondition {
            type: userIsPublicUser
        }
    )

    button login (
        buttonName: LOGIN
        label: Sign in
        layout {
            sequence: 10
            region: @signin
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text-with-icon
            icon: fa-sign-in
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            hot: true
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 9999
            }
        }
    )

    region filter (
        name: Show maps of
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--hideHeader js-addHiddenHeadingRoleDesc
                t-Region--noPadding
            ]
        }
        serverSideCondition {
            type: expression
            plsqlExpression: apex_authorization.is_authorized('IST_ADMIN')
        }
    )

    pageItem P110_USER_ID (
        type: textField
        label {
            label: User id
        }
        layout {
            sequence: 10
            region: @filter
            slot: regionBody
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
        }
        help {
            helpText: Toolkit admins can look at the maps of another user. Everybody else only sees their own maps.
        }
    )

    pageItem P110_USER_TAB (
        type: textField
        label {
            label: User table
        }
        layout {
            sequence: 20
            region: @filter
            slot: regionBody
            startNewRow: false
            columnSpan: 3
        }
        appearance {
            template: @/optional-floating
        }
        help {
            helpText: The user_tab the jobs were created with (APP_USER for jobs created in this toolkit).
        }
    )

    region maps (
        name: Maps
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select job_id,
                       document_name,
                       status,
                       output_format,
                       access_key,
                       'Job #' || job_id || '  ·  ' || to_char(created_at, 'YYYY-MM-DD HH24:MI') as subtitle,
                       nvl(asset_count, 0) || ' features  ·  ' || output_format as body,
                       case output_format when 'KMZ' then 'fa-file-archive-o' else 'fa-globe' end as icon
                  from kml_jobs
                 where user_id  = case when apex_authorization.is_authorized('IST_ADMIN') then :P110_USER_ID else :APP_USER end
                   and user_tab = case when apex_authorization.is_authorized('IST_ADMIN') then :P110_USER_TAB else 'APP_USER' end
                 order by job_id desc
                ```
            pageItemsToSubmit: P110_USER_ID,P110_USER_TAB
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--removeHeader js-removeLandmark
            ]
        }
        card {
            primaryKeyColumn1: JOB_ID
        }
        title {
            column: DOCUMENT_NAME
        }
        subtitle {
            column: SUBTITLE
        }
        body {
            column: BODY
        }
        iconAndBadge {
            iconSource: iconClassColumn
            iconColumn: ICON
            iconPosition: start
            badgeColumn: STATUS
        }
        componentAppearance {
            gridColumns: 3
        }
        pagination {
            type: page
        }
        messages {
            whenNoDataFound: No maps yet.
        }
        serverSideCondition {
            type: userIsAuthenticated
        }

        action open (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 11
                    items: {
                        P11_JOB_ID: &JOB_ID.
                        P11_ACCESS_KEY: &ACCESS_KEY.
                    }
                }
            }
        )
        action edit (
            type: button
            label: Open editor
            layout {
                position: primary
                sequence: 20
            }
            appearance {
                displayType: textWithIcon
                icon: fa-pencil
                hot: true
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 11
                    items: {
                        P11_JOB_ID: &JOB_ID.
                        P11_ACCESS_KEY: &ACCESS_KEY.
                    }
                }
            }
        )
        action download (
            type: button
            label: Download
            layout {
                position: secondary
                sequence: 30
            }
            appearance {
                displayType: textWithIcon
                icon: fa-download
            }
            behavior {
                type: redirectThisApp
                target: {
                    page: 9
                    items: {
                        P9_JOB_ID: &JOB_ID.
                        P9_ACCESS_KEY: &ACCESS_KEY.
                    }
                }
            }
        )
    )

    process init-defaults (
        name: Default user from session
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                begin
                  :P110_USER_ID  := nvl(:P110_USER_ID, :APP_USER);
                  :P110_USER_TAB := nvl(:P110_USER_TAB, 'APP_USER');
                end;
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )

    dynamicAction da-filter-change (
        name: Refresh on filter change
        execution {
            sequence: 10
        }
        when {
            event: change
            selectionType: items
            items: P110_USER_ID,P110_USER_TAB
        }
        action refresh-maps (
            action: refresh
            affectedElements {
                selectionType: region
                region: @maps
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
