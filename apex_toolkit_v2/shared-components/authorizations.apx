authorization IST_ADMIN (
    name: IST_ADMIN
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- Admin gate for every toolkit page except the public ones.
            -- * anonymous (nobody) is never an admin;
            -- * if the workspace defines the group KMLEON_ADMIN, the user must be
            --   a member (manage it under Workspace Administration > Groups);
            -- * without that group every authenticated user is an admin -- the
            --   upgrade-safe default for existing installs. Create the group to
            --   lock the toolkit down.
            declare
              l_n pls_integer;
            begin
              if :APP_USER is null or lower(:APP_USER) = 'nobody' then
                return false;
              end if;
              select count(*) into l_n
                from apex_workspace_groups
               where group_name = 'KMLEON_ADMIN';
              if l_n = 0 then
                return true;
              end if;
              return apex_util.current_user_in_group(p_group_name => 'KMLEON_ADMIN');
            end;
            ```
    }
    error {
        errorMessage: Insufficient privileges - this page requires IST_ADMIN (member of group KMLEON_ADMIN).
    }
)

authorization EDITOR_ACCESS (
    name: EDITOR_ACCESS
    type: plSqlFunctionBody
    settings {
        plsqlFunctionBody:
            ```plsql
            -- Editor / download gate, evaluated on every page view:
            --  * toolkit admins (IST_ADMIN) may open any job;
            --  * everybody else needs the job's access_key in the current page's
            --    own Pnn_JOB_ID / Pnn_ACCESS_KEY items (the "My maps" share link).
            declare
              l_pfx varchar2(10)  := 'P' || :APP_PAGE_ID || '_';
              l_job number        := to_number(v(l_pfx || 'JOB_ID') default null on conversion error);
              l_key varchar2(64)  := v(l_pfx || 'ACCESS_KEY');
              l_n   pls_integer;
            begin
              if apex_authorization.is_authorized('IST_ADMIN') then
                return true;
              end if;
              if l_job is null or l_key is null then
                return false;
              end if;
              select count(*) into l_n
                from kml_jobs
               where job_id = l_job
                 and access_key = l_key;
              return l_n > 0;
            end;
            ```
    }
    error {
        errorMessage: This map link is not valid. Ask the owner for a current link or sign in.
    }
    advanced {
        evaluationType: perPageView
    }
)
